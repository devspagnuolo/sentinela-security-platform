# Copie para deploy/.env (nunca versione esse arquivo) e preencha.

# Domínio público. Sem domínio próprio, use o IP público com sslip.io, ex.: 129-146-10-20.sslip.io
SENTINELA_DOMAIN=sentinela.suaempresa.com.br
# E-mail para o certificado Let's Encrypt (avisos de expiração)
ACME_EMAIL=voce@suaempresa.com.br

# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=
# Gere com: openssl rand -base64 32 — guarde junto dos backups; sem ela o MFA e o SSO precisam ser reconfigurados
SENTINELA_ENCRYPTION_KEY=

# Scanner desabilitado por padrão; só avalia hostnames listados (separados por vírgula)
SENTINELA_ENABLE_SCANNER=0
SENTINELA_ALLOWED_HOSTS=

# Worker de avaliações em segundo plano (roda dentro da aplicação; 0 desliga)
SENTINELA_WORKER=1
SENTINELA_WORKER_CONCURRENCY=2

BACKUP_RETENTION_DAYS=14
SENTINELA_LOG_LEVEL=info
