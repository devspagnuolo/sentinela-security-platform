# Banco de dados. Sem DATABASE_URL, o app usa PostgreSQL embutido (PGlite) em memória
# com dados demonstrativos — somente para desenvolvimento. Em produção é obrigatória.
DATABASE_URL=postgres://sentinela:sentinela_dev_only@localhost:5432/sentinela
DATABASE_POOL_MAX=10
# 1 aplica migrações automaticamente ao iniciar (alternativa: npm run db:migrate)
SENTINELA_AUTO_MIGRATE=0
# Organização padrão usada pelo script create-owner
SENTINELA_DEFAULT_ORG=default
# Owner demonstrativo (admin@sentinela.local) criado pelo seed; sem banco externo, o padrão em dev é sentinela-demo-2026
# SENTINELA_DEMO_PASSWORD=
# Senha do Owner criado por "npm run user:create-owner"; se vazia, uma senha forte é gerada e exibida uma vez
# SENTINELA_OWNER_PASSWORD=

# Origens públicas aceitas em requisições que alteram dados (proteção CSRF), ex.: https://sentinela.suaempresa.com
SENTINELA_PUBLIC_ORIGIN=
# Apenas para testar build de produção sem HTTPS: desliga Secure/__Host- no cookie de sessão
# SENTINELA_INSECURE_COOKIES=1
# PGlite persistente em disco (opcional, apenas sem DATABASE_URL)
# SENTINELA_PGLITE_DIR=./.data/pglite

# Scanner: desabilitado por padrão; só avalia hostnames listados aqui
SENTINELA_ENABLE_SCANNER=0
SENTINELA_ALLOWED_HOSTS=
