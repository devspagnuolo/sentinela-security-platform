# Banco de dados. Sem DATABASE_URL, o app usa PostgreSQL embutido (PGlite) em memória
# com dados demonstrativos — somente para desenvolvimento. Em produção é obrigatória.
DATABASE_URL=postgres://sentinela:sentinela_dev_only@localhost:5432/sentinela
DATABASE_POOL_MAX=10
# 1 aplica migrações automaticamente ao iniciar (alternativa: npm run db:migrate)
SENTINELA_AUTO_MIGRATE=0
# Organização usada até a fase de login/RBAC
SENTINELA_DEFAULT_ORG=default
# PGlite persistente em disco (opcional, apenas sem DATABASE_URL)
# SENTINELA_PGLITE_DIR=./.data/pglite

# Scanner: desabilitado por padrão; só avalia hostnames listados aqui
SENTINELA_ENABLE_SCANNER=0
SENTINELA_ALLOWED_HOSTS=
